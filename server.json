{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.robyroro/PersonaMCP",
  "title": "PersonaMCP",
  "description": "Local-first memory of how you write: style profile and real reply examples from your chat exports",
  "repository": {
    "url": "https://github.com/robyroro/PersonaMCP",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "personamcp",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
